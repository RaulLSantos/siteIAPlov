    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const status = String($json.status || '').trim();\nconst statusLower = status.toLowerCase();\nconst inicialEnviada = String($json.mensagem_inicial_enviada || '').trim().toLowerCase() === 'sim';\nconst confirmacaoEnviada = String($json.confirmacao_enviada || '').trim().toLowerCase() === 'sim';\nconst whatsapp = String($json.whatsapp_normalizado || '').replace(/\\D/g, '');\nconst whatsappValido = /^55\\d{10,11}$/.test(whatsapp);\nconst now = new Date().toISOString();\nconst nome = String($json.nome || '').trim();\nconst evento = String($json.evento || '').trim();\nconst mensagemInicialTemplate = 'Olá, {{nome}}! Recebemos sua inscrição para o evento {{evento}}. Em breve enviaremos mais informações.';\nconst mensagemConfirmacaoTemplate = 'Olá, {{nome}}! Sua inscrição no evento {{evento}} foi confirmada com sucesso.';\nconst render = (template) => template.replaceAll('{{nome}}', nome).replaceAll('{{evento}}', evento);\nlet route = 'ignorar';\nlet messageType = '';\nlet message = '';\nlet error = '';\nif (!whatsappValido && ['nova inscrição', 'concluído', 'pagamento feito'].includes(statusLower)) {\n  route = 'erro_whatsapp';\n  error = 'WhatsApp vazio ou inválido';\n} else if (statusLower === 'nova inscrição' && !inicialEnviada) {\n  route = 'mensagem_inicial';\n  messageType = 'inicial';\n  message = render(mensagemInicialTemplate);\n} else if ((statusLower === 'concluído' || statusLower === 'pagamento feito') && !confirmacaoEnviada) {\n  route = 'confirmacao';\n  messageType = 'confirmacao';\n  message = render(mensagemConfirmacaoTemplate);\n}\nreturn {\n  json: {\n    ...$json,\n    status_normalizado: status,\n    route,\n    messageType,\n    whatsapp_destino: whatsapp,\n    mensagem_whatsapp: message,\n    erro_processamento: error,\n    processedAt: now\n  }\n};"
      },
