root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,md,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ts,tsx}]
# Prefer explicit semicolons and double quotes in the project code style
# Note: editorconfig does not enforce quotes/semicolons at runtime; linters should be used for that.